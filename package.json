{
  "name": "gas-safe-register-uk",
  "version": "0.0.1",
  "type": "module",
  "description": "Search the UK Gas Safe Register by town or postcode and collect business, engineer, and qualification data.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@crawlee/browser-pool": "3.18.2",
    "@crawlee/cheerio": "^3.15.3",
    "@crawlee/playwright": "3.18.2",
    "apify": "3.7.2",
    "camoufox-js": "0.12.1",
    "cheerio": "1.2.0",
    "got-scraping": "4.2.2",
    "patchright": "1.63.0",
    "playwright": "1.64.0",
    "tough-cookie": "6.0.2"
  },
  "devDependencies": {
    "@apify/eslint-config": "^2.0.0",
    "@apify/tsconfig": "^0.2.0",
    "@types/node": "24.19.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.0.0",
    "prettier": "^3.5.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "author": "leadomi",
  "license": "ISC",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
